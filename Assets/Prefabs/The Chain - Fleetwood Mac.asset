    168.0|Snare, 168.0|FloorTom, 168.5|Kick\r\n\r\n# Compasso 43\r\n169.0|Kick, 169.0|Crash,
    169.0|Snare, 169.5|Kick\r\n170.0|Kick, 170.0|Snare, 170.0|FloorTom, 170.5|Kick\r\n171.0|Kick,
    171.0|Snare, 171.0|FloorTom, 171.5|Kick\r\n172.0|Kick, 172.0|Snare, 172.0|FloorTom,
