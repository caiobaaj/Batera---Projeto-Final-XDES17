  partituraEmTexto: "# =================================================================\r\n#
    FLEETWOOD MAC - THE CHAIN (TRADU\xC7\xC3O ESTRITA DO PDF - 81 COMPASSOS)\r\n#
    BPM: 76 | Time Signature: 4/4 | Approach Time: 2.0\r\n# =================================================================\r\n\r\n#
    --- INTRO & VERSE 1 (Compassos 1 a 16) ---\r\n# Compasso 1\r\n1.0|Kick, 2.0|Kick,
    3.0|Kick, 4.0|Kick\r\n# Compasso 2\r\n5.0|Kick, 6.0|Kick, 7.0|Kick, 8.0|Kick\r\n#
    Compasso 3\r\n9.0|Kick, 10.0|Kick, 11.0|Kick, 12.0|Kick\r\n# Compasso 4\r\n13.0|Kick,
    14.0|Kick, 15.0|Kick, 16.0|Kick\r\n# Compasso 5\r\n17.0|Kick, 18.0|Kick, 19.0|Kick,
    20.0|Kick\r\n# Compasso 6\r\n21.0|Kick, 22.0|Kick, 23.0|Kick, 24.0|Kick\r\n#
    Compasso 7\r\n25.0|Kick, 26.0|Kick, 27.0|Kick, 28.0|Kick\r\n# Compasso 8 (Bumbo
    + Prato no tempo 3, pausa no 4)\r\n29.0|Kick, 30.0|Kick, 31.0|Kick, 31.0|HHO,
    31.25|HHP\r\n# Compasso 9\r\n33.0|Kick, 34.0|Kick, 35.0|Kick, 36.0|Kick\r\n#
    Compasso 10\r\n37.0|Kick, 38.0|Kick, 39.0|Kick, 40.0|Kick\r\n# Compasso 11\r\n41.0|Kick,
    42.0|Kick, 43.0|Kick, 44.0|Kick\r\n# Compasso 12\r\n45.0|Kick, 46.0|Kick, 47.0|Kick,
    48.0|Kick\r\n# Compasso 13\r\n49.0|Kick, 50.0|Kick, 51.0|Kick, 52.0|Kick\r\n#
    Compasso 14\r\n53.0|Kick, 54.0|Kick, 55.0|Kick, 56.0|Kick\r\n# Compasso 15\r\n57.0|Kick,
    58.0|Kick, 59.0|Kick, 60.0|Kick\r\n# Compasso 16 (Virada no tempo 4: Kick ->
    Snare -> HighTom)\r\n61.0|Kick, 62.0|Kick, 63.0|Kick, 64.0|FloorTom, 64.25|LowTom\r\n\r\n#
    --- CHORUS 1 (Compassos 17 a 24) ---\r\n# Compasso 17\r\n65.0|Snare, 65.5|FloorTom,
    66.0|Snare, 66.5|FloorTom\r\n67.0|Snare, 67.5|FloorTom, 68.0|Snare, 68.5|FloorTom\r\n\r\n#
    Compasso 18\r\n69.0|Snare, 69.5|FloorTom, 70.0|Snare, 70.5|FloorTom\r\n71.0|Snare,
    71.5|FloorTom, 72.0|Snare, 72.5|FloorTom\r\n\r\n# Compasso 19\r\n73.0|Crash,
    73.5|FloorTom, 74.0|Snare, 74.5|FloorTom\r\n75.0|Snare, 75.5|FloorTom, 76.0|Snare,
    76.5|FloorTom\r\n\r\n# Compasso 20\r\n77.0|Snare, 77.5|FloorTom, 78.0|Snare,
    78.5|FloorTom\r\n79.0|Snare, 79.25|Snare, 79.5|Snare, 79.75|Snare\r\n80.0|Snare,
    80.25|Snare, 80.5|Snare, 80.75|Snare\r\n\r\n# Compasso 21\r\n81.0|Snare, 81.5|FloorTom,
    82.0|Snare, 82.5|FloorTom\r\n83.0|Snare, 83.5|FloorTom, 84.0|Snare, 84.5|FloorTom\r\n\r\n#
    Compasso 22\r\n85.0|Snare, 85.5|FloorTom, 86.0|Snare, 86.5|FloorTom\r\n87.0|Snare,
    87.5|FloorTom, 88.0|Snare, 88.5|FloorTom\r\n\r\n# Compasso 23\r\n89.0|Crash,
    89.5|FloorTom, 90.0|Snare, 90.5|FloorTom\r\n91.0|Snare, 91.5|FloorTom, 92.0|Snare,
    92.5|FloorTom\r\n\r\n# Compasso 24\r\n93.0|Snare, 93.5|FloorTom, 94.0|Snare,
    94.5|FloorTom\r\n95.0|Snare, 95.25|Snare, 95.5|Snare, 95.75|Snare\r\n96.0|Snare,
    96.25|Snare, 96.5|Snare, 96.75|Snare\r\n\r\n# --- RE-INTRO & VERSE 2 (Compassos
    25 a 40) ---\r\n# Compasso 25 (Pausa)\r\n# Compasso 26 (Pausa)\r\n\r\n# Compasso
    27\r\n105.0|Kick, 106.0|Kick, 107.0|Kick, 107.5|Ride, 108.0|Kick\r\n# Compasso
    28 (Abertura o e fechamento + de Hi-Hat no tempo 3)\r\n109.0|Kick, 110.0|Kick,
    111.0|Kick, 111.0|HHO, 111.25|HHC\r\n# Compasso 29\r\n113.0|Kick, 114.0|Kick,
    115.0|Kick, 116.0|Kick\r\n# Compasso 30\r\n117.0|Kick, 118.0|Kick, 119.0|Kick,
    120.0|Kick\r\n# Compasso 31\r\n121.0|Kick, 122.0|Kick, 123.0|Kick, 124.0|Kick\r\n#
    Compasso 32 (Tercina no Hi-Hat no tempo 3.5 -> 4.0)\r\n125.0|Kick, 126.0|Kick,
    127.0|Kick, 127.5|HHC, 127.67|HHC, 127.83|HHC, 128.0|HHC\r\n# Compasso 33\r\n129.0|Kick,
    130.0|Kick, 131.0|Kick, 132.0|Kick\r\n# Compasso 34\r\n133.0|Kick, 134.0|Kick,
    135.0|Kick, 136.0|Kick\r\n# Compasso 35\r\n137.0|Kick, 138.0|Kick, 139.0|Kick,
    140.0|Kick\r\n# Compasso 36\r\n141.0|Kick, 142.0|Kick, 143.0|Kick, 144.0|Kick\r\n#
    Compasso 37\r\n145.0|Kick, 146.0|Kick, 147.0|Kick, 148.0|Kick\r\n# Compasso 38\r\n149.0|Kick,
    150.0|Kick, 151.0|Kick, 152.0|Kick\r\n# Compasso 39\r\n153.0|Kick, 154.0|Kick,
    155.0|Kick, 156.0|Kick\r\n# Compasso 40 (Virada no tempo 4)\r\n157.0|Kick, 158.0|Kick,
    159.0|Kick, 160.0|Kick, 160.25|Snare, 160.5|Snare\r\n\r\n# --- CHORUS 2 (Compassos
    41 a 52) ---\r\n# Compasso 41\r\n161.0|Kick, 161.0|Snare, 161.0|FloorTom, 161.5|Kick\r\n162.0|Kick,
    162.0|Snare, 162.0|FloorTom, 162.5|Kick\r\n163.0|Kick, 163.0|Snare, 163.0|FloorTom,
